[Unit]
Description=gate-llm -- on-demand wake proxy for AI services on a single GPU
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
# The gatekeeper needs the rights to run the start/stop commands declared in
# the config (docker, systemctl, direct processes). Running as root is the
# simple option on a single-purpose box; on a shared box, use a dedicated
# user that belongs to the docker group and may start/stop the units.
User=root
ExecStart=/usr/bin/python3 /opt/gate-llm/gate_llm_proxy.py --config /etc/gate-llm/services.json
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
